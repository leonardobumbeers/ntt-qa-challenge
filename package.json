{
  "name": "ntt-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript E2E and API test automation for ServeRest using native Cypress resources",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "audit:selectors": "cypress run --spec \"cypress/e2e/discovery/**/*.cy.ts\" --config specPattern=\"cypress/e2e/**/*.cy.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "cypress": "^15.19.0",
    "eslint": "^9.0.0",
    "eslint-plugin-cypress": "^6.4.3",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
